<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Only the keys Xcode will not generate live here; GENERATE_INFOPLIST_FILE
	  stays on and the build merges the usual CFBundle* and INFOPLIST_KEY_*
	  values into this dictionary.

	  UIBackgroundModes is here because `INFOPLIST_KEY_UIBackgroundModes` is
	  silently ignored -- it built clean and produced an Info.plist with no
	  UIBackgroundModes key at all, which would have shipped a Picture in
	  Picture window that dies the instant the app is backgrounded, i.e. at
	  exactly the moment it becomes useful.

	  The `audio` mode is what keeps the PiP window alive in the background.
	  ClipKeep plays no audio: the session it activates is configured with
	  .mixWithOthers precisely so it never interrupts what you are actually
	  listening to. See ClipPiPController for the full explanation.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
